# Bridge facial AI / mesh 3D — configurat local, fara weights in Git
# BERRY_MODEL_BRIDGE_CONFIG=C:\BERRY\model_bridge.local.json
# BERRY_BRIDGE_TIMEOUT=1800

# YouTube / Google OAuth 2.0 — PREGATIRE OFFLINE; NU activeaza conectarea
# Creeaza proiect Google Cloud si un OAuth client de tip Web application.
# Nu pune niciodata un client_secret real in GitHub, chat sau .env.example.
# BERRY_GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# BERRY_GOOGLE_OAUTH_CLIENT_SECRET_FILE=C:\Users\YOU\AppData\Local\BERRY_AI_AUTOPILOT\private\google_oauth_client.json
# Redirect viitor Windows (NU functioneaza pe iPhone fara backend HTTPS):
# http://localhost:8765/api/integrations/youtube/callback
# Scope doar pentru identificarea canalelor: https://www.googleapis.com/auth/youtube.readonly
# Endpointurile legacy /api/integrations/youtube/* raman offline/423.
# Noul /api/social/youtube/* poate fi activat explicit doar pentru citire.

# JARVIS ONE ULTIMATE: local API only; 32+ chars, separate from BERRY_ACCESS_KEY
# BERRY_JARVIS_API_KEY=choose_32_plus_random_chars

# Optional read-only social OAuth; remains DISABLED until explicit configuration
# BERRY_ACCESS_KEY=choose_16_plus_random_chars
# BERRY_SOCIAL_OAUTH_ENABLED=false
# Google OAuth Web application, redirect http://localhost:8765/api/social/youtube/callback
# BERRY_GOOGLE_OAUTH_CLIENT_ID=example.apps.googleusercontent.com
# BERRY_GOOGLE_OAUTH_CLIENT_SECRET_FILE=C:\Users\YOU\AppData\Local\BERRY_AI_AUTOPILOT\private\google_oauth_client.json
# TikTok and Instagram usually require an approved public HTTPS redirect and developer app review.
# Do not enable external server/tunnel without separate approval.
# BERRY_SOCIAL_REDIRECT_BASE=https://your-approved-domain.example
# BERRY_YOUTUBE_REDIRECT_BASE=http://localhost:8765
# BERRY_TIKTOK_REDIRECT_BASE=https://your-approved-domain.example
# BERRY_INSTAGRAM_REDIRECT_BASE=https://your-approved-domain.example
# BERRY_TIKTOK_CLIENT_KEY=your_tiktok_client_key
# BERRY_TIKTOK_CLIENT_SECRET_FILE=C:\Users\YOU\AppData\Local\BERRY_AI_AUTOPILOT\private\tiktok_secret.txt
# BERRY_INSTAGRAM_APP_ID=your_instagram_app_id
# BERRY_INSTAGRAM_APP_SECRET_FILE=C:\Users\YOU\AppData\Local\BERRY_AI_AUTOPILOT\private\instagram_secret.txt
# OAuth only reads profile/channel; no posting or upload permissions.

# OpenClipper desktop MCP (read-only, loopback only)
# OPEN_CLIPPER_MCP_PORT=12742
# BERRY_HYPERFRAMES_BIN=C:\BERRY\local_engines\HyperFrames\node_modules\.bin\hyperframes.cmd

# GSAP local pentru HyperFrames, daca CLI-ul nu include vendor:
# BERRY_HYPERFRAMES_GSAP_PATH=C:\\BERRY\\gsap.min.js
