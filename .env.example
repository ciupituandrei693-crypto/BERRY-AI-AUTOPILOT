# BERRY_PREVIEW_MAX_SECONDS=8
# BERRY_OUTPUT_DIR=C:\BERRY_PRIVATE_OUTPUTS
# BERRY_SAPI_TTS=true   # Windows SAPI offline fallback, vocea depinde de Windows
# BERRY_ASSET_DIR=C:\BERRY_PRIVATE_ASSETS
# BERRY_SCRIPT_DIR=C:\BERRY_PRIVATE_SCRIPTS
# Modelele AI, serverul extern, GPU cloud și OAuth NU sunt activate implicit.
# Copiaza configuratia in .env.local (doar local, niciodata GitHub).
# BERRY_COMFYUI_URL=http://127.0.0.1:8188
# BERRY_COMFYUI_WORKFLOW=C:\BERRY\workflows\fruit_image_api.json
# BERRY_ACE_STEP_URL=http://127.0.0.1:8001
# BERRY_WANGP_ROOT=C:\WanGP
# BERRY_WANGP_PYTHON=C:\WanGP\.venv\Scripts\python.exe
# BERRY_WANGP_SETTINGS=C:\BERRY\workflows\wangp_export_settings.json
# BERRY_WHISPER_MODEL=C:\BERRY\models\faster-whisper-small
# BERRY_WHISPER_PYTHON=C:\BERRY\whisper-env\Scripts\python.exe
# BERRY_VOICESTUDIO_URL=http://127.0.0.1:3900
# Cloud, OAuth, GPU inchiriat si server extern sunt intentionat neconfigurate.
# BERRY_VOICESTUDIO_VOICE=default
# BERRY_VOICESTUDIO_MODEL=tts-1

# 3D rigging + local phonetic lip-sync
# BERRY_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe
# BERRY_RHUBARB_PATH=C:\tools\rhubarb\rhubarb.exe
# BERRY_3D_MAX_SECONDS=6
# BERRY_3D_WIDTH=360
